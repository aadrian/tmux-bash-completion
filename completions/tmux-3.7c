#!/usr/bin/env bash
# Built for tmux 3.7c.

# Copy of https://github.com/Bash-it/bash-it/blob/master/completion/available/tmux.completion.bash
# and https://github.com/przepompownia/bash-it/blob/master/completion/available/tmux.completion.bash
# slightly refactored

# tmux completion
# See: http://www.debian-administration.org/articles/317 for how to write more.
# Usage: Put "source bash_completion_tmux.sh" into your .bashrc
# Based upon the example at http://paste-it.appspot.com/Pj4mLycDE

function _tmux_complete_client() {
    local IFS=$'\n'
    local cur="${1}" && shift
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "$(tmux "$@" list-clients -F '#{client_tty}' 2> /dev/null)" -- "${cur}")
    options=""
    return 0
}

function _tmux_complete_session() {
    local IFS=$'\n'
    local cur="${1}" && shift
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "$(tmux "$@" list-sessions -F '#{session_name}' 2> /dev/null)" -- "${cur}")
    options=""
    return 0
}

function _tmux_complete_window() {
    local IFS=$'\n'
    local cur="${1}" && shift
    local session_name="$(echo "${cur}" | sed 's/\\//g' | cut -d ':' -f 1)"
    local sessions

    sessions="$(tmux "$@" list-sessions 2> /dev/null | sed -re 's/([^:]+:).*$/\1/')"
    if [[ -n "${session_name}" ]]; then
        sessions="${sessions}
        $(tmux "$@" list-windows -t "${session_name}" 2> /dev/null | sed -re 's/^([^:]+):.*$/'"${session_name}"':\1/')"
    fi
    cur="$(echo "${cur}" | sed -e 's/:/\\\\:/')"
    sessions="$(echo "${sessions}" | sed -e 's/:/\\\\:/')"
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "${sessions}" -- "${cur}")
    options=""
    return 0
}

function _tmux_complete_pane() {
    local IFS=$'\n'
    local cur="${1}" && shift
    local panes
    panes="$(tmux "$@" list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}' 2> /dev/null)"
    cur="$(echo "${cur}" | sed -e 's/:/\\\\:/')"
    panes="$(echo "${panes}" | sed -e 's/:/\\\\:/')"
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "${panes}" -- "${cur}")
    options=""
    return 0
}

function _tmux_complete_buffer_name() {
    local IFS=$'\n'
    local cur="${1}" && shift
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "$(tmux "$@" list-buffers -F '#{buffer_name}' 2> /dev/null)" -- "${cur}")
    options=""
    return 0
}

function _tmux_complete_key_table() {
    local IFS=$'\n'
    local cur="${1}" && shift
    # tmux has no "list key tables" command; offer the built-in tables plus
    # whatever tables currently have bindings (covers custom -T tables from
    # the user's config).
    local tables
    tables="$(
        {
            printf '%s\n' prefix root copy-mode copy-mode-vi
            tmux "$@" list-keys -F '#{key_table}' 2> /dev/null
        } | sort -u
    )"
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "${tables}" -- "${cur}")
    options=""
    return 0
}

function _tmux_complete_socket_name() {
    local IFS=$'\n'
    local cur="${1}" && shift
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "$(find "${TMUX_TMPDIR:-/tmp}/tmux-$UID" -type s -printf '%P\n')" -- "${cur}")
    options=""
    return 0
}
function _tmux_complete_socket_path() {
    local IFS=$'\n'
    local cur="${1}" && shift
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "$(find "${TMUX_TMPDIR:-/tmp}/tmux-$UID" -type s -printf '%p\n')" -- "${cur}")
    options=""
    return 0
}

__tmux_init_completion()
{
    COMPREPLY=()
    _get_comp_words_by_ref cur prev words cword
}

# Dispatches a tmux (sub)command name (canonical or alias) to its
# flag-value completion. $cur/$prev/$tmux_args and $options come from
# the caller (_tmux(), in core.bash) via dynamic scoping.
_tmux_dispatch_command() {
    case $1 in
            attach-session|attach)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-c -d -E -f -r -t -x" ;;
            esac ;;
            bind-key|bind)
            case "$prev" in
                -T) _tmux_complete_key_table "${cur}" "${tmux_args[@]}" ;;
                *) options="-n -N -r -T" ;;
            esac ;;
            break-pane|breakp)
            case "$prev" in
                -s) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -b -d -F -n -P -s -t" ;;
            esac ;;
            capture-pane|capturep)
            case "$prev" in
                -b) _tmux_complete_buffer_name "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -b -C -e -E -F -H -J -L -M -N -p -P -q -S -t -T" ;;
            esac ;;
            choose-buffer)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-f -F -K -N -O -r -t -Z" ;;
            esac ;;
            choose-client)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-f -F -K -N -O -r -t -Z" ;;
            esac ;;
            choose-tree)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-f -F -G -K -N -O -r -s -t -w -Z" ;;
            esac ;;
            clear-history|clearhist)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-H -t" ;;
            esac ;;
            clear-prompt-history|clearphist)
            case "$prev" in
                *) options="-T" ;;
            esac ;;
            clock-mode)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            command-prompt)
            case "$prev" in
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-1 -b -C -e -F -i -I -k -l -N -p -t -T" ;;
            esac ;;
            confirm-before|confirm)
            case "$prev" in
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-b -c -p -t -y" ;;
            esac ;;
            copy-mode)
            case "$prev" in
                -s) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-d -e -H -M -q -s -S -t -u" ;;
            esac ;;
            customize-mode)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-f -F -N -t -Z" ;;
            esac ;;
            delete-buffer|deleteb)
            case "$prev" in
                -b) _tmux_complete_buffer_name "${cur}" "${tmux_args[@]}" ;;
                *) options="-b" ;;
            esac ;;
            detach-client|detach)
            case "$prev" in
                -s) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -E -P -s -t" ;;
            esac ;;
            display-menu|menu)
            case "$prev" in
                -c) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-b -c -C -H -M -O -s -S -t -T -x -y" ;;
            esac ;;
            display-message|display)
            case "$prev" in
                -c) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -c -C -d -F -I -l -N -p -t -v" ;;
            esac ;;
            display-panes|displayp)
            case "$prev" in
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-b -d -N -t" ;;
            esac ;;
            display-popup|popup)
            case "$prev" in
                -c) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                -d) _filedir -d ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-b -B -c -C -d -e -E -h -k -N -s -S -t -T -w -x -y" ;;
            esac ;;
            find-window|findw)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-C -i -N -r -t -T -Z" ;;
            esac ;;
            has-session|has)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            if-shell|if)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-b -F -t" ;;
            esac ;;
            join-pane|joinp)
            case "$prev" in
                -s) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-b -d -f -h -l -s -t -v" ;;
            esac ;;
            kill-pane|killp)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -t" ;;
            esac ;;
            kill-server)
            ;;
            kill-session)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -C -g -t" ;;
            esac ;;
            kill-window|killw)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -t" ;;
            esac ;;
            last-pane|lastp)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-d -e -t -Z" ;;
            esac ;;
            last-window|last)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            link-window|linkw)
            case "$prev" in
                -s) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -b -d -k -s -t" ;;
            esac ;;
            list-buffers|lsb)
            case "$prev" in
                *) options="-f -F -O" ;;
            esac ;;
            list-clients|lsc)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-f -F -O -t" ;;
            esac ;;
            list-commands|lscm)
            case "$prev" in
                *) options="-F" ;;
            esac ;;
            list-keys|lsk)
            case "$prev" in
                -T) _tmux_complete_key_table "${cur}" "${tmux_args[@]}" ;;
                *) options="-1 -a -F -N -O -P -r -T" ;;
            esac ;;
            list-panes|lsp)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -f -F -O -r -s -t" ;;
            esac ;;
            list-sessions|ls)
            case "$prev" in
                *) options="-f -F -O -r" ;;
            esac ;;
            list-windows|lsw)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -f -F -O -r -t" ;;
            esac ;;
            load-buffer|loadb)
            case "$prev" in
                -b) _tmux_complete_buffer_name "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) _filedir ;;
            esac ;;
            lock-client|lockc)
            case "$prev" in
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            lock-server|lock)
            ;;
            lock-session|locks)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            move-pane|movep)
            case "$prev" in
                -s) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-b -d -f -h -l -s -t -v" ;;
            esac ;;
            move-window|movew)
            case "$prev" in
                -s) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -b -d -k -r -s -t" ;;
            esac ;;
            new-pane|newp)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-b -c -d -e -f -F -h -I -k -l -m -p -P -R -s -S -t -v -x -X -y -Y -Z" ;;
            esac ;;
            new-session|new)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-A -c -d -D -e -E -f -F -n -P -s -t -x -X -y" ;;
            esac ;;
            new-window|neww)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-a -b -c -d -e -F -k -n -P -S -t" ;;
            esac ;;
            next-layout|nextl)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            next-window|next)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -t" ;;
            esac ;;
            paste-buffer|pasteb)
            case "$prev" in
                -b) _tmux_complete_buffer_name "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-b -d -p -r -s -S -t" ;;
            esac ;;
            pipe-pane|pipep)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-I -o -O -t" ;;
            esac ;;
            previous-layout|prevl)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            previous-window|prev)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -t" ;;
            esac ;;
            refresh-client|refresh)
            case "$prev" in
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-A -B -c -C -D -f -l -L -r -R -S -t -U" ;;
            esac ;;
            rename-session|rename)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            rename-window|renamew)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            resize-pane|resizep)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-D -L -M -R -t -T -U -x -y -Z" ;;
            esac ;;
            resize-window|resizew)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -A -D -L -R -t -U -x -y" ;;
            esac ;;
            respawn-pane|respawnp)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-c -e -k -t" ;;
            esac ;;
            respawn-window|respawnw)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-c -e -k -t" ;;
            esac ;;
            rotate-window|rotatew)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-D -t -U -Z" ;;
            esac ;;
            run-shell|run)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-b -c -C -d -E -t" ;;
            esac ;;
            save-buffer|saveb)
            case "$prev" in
                -b) _tmux_complete_buffer_name "${cur}" "${tmux_args[@]}" ;;
                *) _filedir ;;
            esac ;;
            select-layout|selectl)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-E -n -o -p -t" ;;
            esac ;;
            select-pane|selectp)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-d -D -e -l -L -m -M -R -t -T -U -Z" ;;
            esac ;;
            select-window|selectw)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-l -n -p -t -T" ;;
            esac ;;
            send-keys|send)
            case "$prev" in
                -c) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-c -F -H -K -l -M -N -R -t -X" ;;
            esac ;;
            send-prefix)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-2 -t" ;;
            esac ;;
            server-access)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -d -l -r -t -w" ;;
            esac ;;
            set-buffer|setb)
            case "$prev" in
                -b) _tmux_complete_buffer_name "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -b -n -t -w" ;;
            esac ;;
            set-environment|setenv)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-F -g -h -r -t -u" ;;
            esac ;;
            set-hook)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -g -p -R -t -u -w" ;;
            esac ;;
            set-option|set)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -F -g -o -p -q -s -t -u -U -w" ;;
            esac ;;
            set-window-option|setw)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -F -g -o -q -t -u" ;;
            esac ;;
            show-buffer|showb)
            case "$prev" in
                -b) _tmux_complete_buffer_name "${cur}" "${tmux_args[@]}" ;;
                *) options="-b" ;;
            esac ;;
            show-environment|showenv)
            case "$prev" in
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                *) options="-g -h -s -t" ;;
            esac ;;
            show-hooks)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-g -p -t -w" ;;
            esac ;;
            show-messages|showmsgs)
            case "$prev" in
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-J -t -T" ;;
            esac ;;
            show-options|show)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-A -g -H -p -q -s -t -v -w" ;;
            esac ;;
            show-prompt-history|showphist)
            case "$prev" in
                *) options="-T" ;;
            esac ;;
            show-window-options|showw)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-g -t -v" ;;
            esac ;;
            source-file|source)
            case "$prev" in
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) _filedir ;;
            esac ;;
            split-window|splitw)
            case "$prev" in
                -c) _filedir -d ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) _tmux_dispatch_shell_command "-b -c -d -e -f -F -h -I -k -l -m -p -P -R -s -S -t -v -Z" ;;
            esac ;;
            start-server|start)
            ;;
            suspend-client|suspendc)
            case "$prev" in
                -t) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                *) options="-t" ;;
            esac ;;
            swap-pane|swapp)
            case "$prev" in
                -s) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_pane "${cur}" "${tmux_args[@]}" ;;
                *) options="-d -D -s -t -U -Z" ;;
            esac ;;
            swap-window|swapw)
            case "$prev" in
                -s) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-d -s -t" ;;
            esac ;;
            switch-client|switchc)
            case "$prev" in
                -c) _tmux_complete_client "${cur}" "${tmux_args[@]}" ;;
                -t) _tmux_complete_session "${cur}" "${tmux_args[@]}" ;;
                -T) _tmux_complete_key_table "${cur}" "${tmux_args[@]}" ;;
                *) options="-c -E -l -n -O -p -r -t -T -Z" ;;
            esac ;;
            unbind-key|unbind)
            case "$prev" in
                -T) _tmux_complete_key_table "${cur}" "${tmux_args[@]}" ;;
                *) options="-a -n -q -T" ;;
            esac ;;
            unlink-window|unlinkw)
            case "$prev" in
                -t) _tmux_complete_window "${cur}" "${tmux_args[@]}" ;;
                *) options="-k -t" ;;
            esac ;;
            wait-for|wait)
            case "$prev" in
                *) options="-L -S -U" ;;
            esac ;;
    esac
}

# Commands whose usage ends in a trailing shell-command (new-session,
# new-window, run-shell, ...) need hand-written completion beyond flag
# values: once `--` appears, everything after it is a shell command line,
# not a tmux flag. _tmux_dispatch_command (generated) doesn't attempt
# general positional/nested-command completion, so its per-command arms
# call this instead for exactly those commands (see generate.sh). $flags
# is the same fallback flag-list _tmux_dispatch_command would otherwise
# have used, passed in to avoid recursing back into it.
_tmux_dispatch_shell_command() {
    local flags=$1
    local i dashdash_index=-1
    for ((i = index; i < cword; i++)); do
        if [[ ${words[i]} == -- ]]; then
            dashdash_index=i
            break
        fi
    done
    if [[ $dashdash_index -ge 0 ]]; then
        _command_offset $((dashdash_index + 1))
    else
        options="$flags"
    fi
}

_tmux() {
    local cur prev words cword;
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion
    else
        __tmux_init_completion
    fi

    local index=1
    # Check tmux options that will change completion for:
    # - available sessions
    # - available windows
    # - ...
    local argv=( "${words[@]:1}" )
    local OPTIND OPTARG OPTERR=0 flag tmux_args=()
    while getopts "L:S:" flag "${argv[@]}"; do
        case "$flag" in
            L) tmux_args+=(-L "$OPTARG") ;;
            S) tmux_args+=(-S "$OPTARG") ;;
            *) ;;
        esac
    done
    # Completed -- have a space after
    if [[ ${#words[@]} -gt $OPTIND ]]; then
        local tmux_argc=${#tmux_args[@]}
        (( index+=tmux_argc ))
        (( cword-=tmux_argc ))
    fi

    local options=""
    if [[ $cword -eq 1 ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$(tmux start\; list-commands | cut -d' ' -f1)" -- "$cur")
        return 0
    else
        case ${words[index]} in
            -L) _tmux_complete_socket_name "${cur}" ;;
            -S) _tmux_complete_socket_path "${cur}" ;;
            *) _tmux_dispatch_command "${words[index]}" ;;
        esac # case ${cmd}
    fi # command specified

    if [[ -n "${options}" ]]; then
        mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "${options}" -- "${cur}")
    fi

    return 0
}
# http://linux.die.net/man/1/bash
complete -F _tmux tmux

# END tmux completion
